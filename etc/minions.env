# .minions runtime configuration
# Source this file to get MINIONS_* variables

# Base directory (override to relocate the entire .minions tree)
MINIONS_HOME="${MINIONS_HOME:-${HOME}/.minions}"

# LLM Proxy Configuration
# Default: OmniRoute (broadest free coverage, quota-aware fallback)
# Alternative: ModelRelay (auto-fastest free coding model routing)
# Format: http://localhost:PORT/v1
MINIONS_LLM_BASE_URL="${MINIONS_LLM_BASE_URL:-http://localhost:20128/v1}"

# OmniRoute Configuration
OMNIROUTE_HOST="${OMNIROUTE_HOST:-127.0.0.1}"
OMNIROUTE_PORT="${OMNIROUTE_PORT:-20128}"
OMNIROUTE_BASE_URL="http://${OMNIROUTE_HOST}:${OMNIROUTE_PORT}/v1"

# ModelRelay Configuration
MODELRELAY_HOST="${MODELRELAY_HOST:-127.0.0.1}"
MODELRELAY_PORT="${MODELRELAY_PORT:-7352}"
MODELRELAY_BASE_URL="http://${MODELRELAY_HOST}:${MODELRELAY_PORT}/v1"

# Pi-Agent Configuration
PI_RPC_HOST="${PI_RPC_HOST:-127.0.0.1}"
PI_RPC_PORT="${PI_RPC_PORT:-8080}"
PI_RPC_BASE_URL="http://${PI_RPC_HOST}:${PI_RPC_PORT}"

# Hermes Configuration
# Set MINIONS_HERMES=on to enable Hermes gateway at boot (opt-in)
MINIONS_HERMES="${MINIONS_HERMES:-off}"
HERMES_HOST="${HERMES_HOST:-127.0.0.1}"
HERMES_GATEWAY_PORT="${HERMES_GATEWAY_PORT:-8081}"

# Log level for all services (debug, info, warn, error)
MINIONS_LOG_LEVEL="${MINIONS_LOG_LEVEL:-info}"

# Daemon mode (if on, boot.sh detaches after printing ready message)
MINIONS_DAEMON="${MINIONS_DAEMON:-off}"

# Node.js path (vendored node if system node < 22.22.2)
MINIONS_NODE_PATH="${MINIONS_HOME}/lib/node/bin"

# uv path (vendored uv for Hermes)
MINIONS_UV_PATH="${MINIONS_HOME}/lib/uv"